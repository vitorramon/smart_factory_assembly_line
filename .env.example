# Copie para .env (fora do Git) só se precisar mudar algum padrão.

# Porta do broker MQTT publicada no computador (as placas ESP32 conectam nela)
SFAL_MQTT_PORT=1883
# Porta do painel
SFAL_HTTP_PORT=8000
# Porta do Ollama publicada só em localhost (perfil "ia")
SFAL_OLLAMA_PORT=11434
# Modelo da IA local (precisa estar baixado: docker compose exec ollama ollama pull <modelo>)
SFAL_OLLAMA_MODEL=qwen2.5:7b
# Estações com placa real, separadas por vírgula: o simulador deixa de simulá-las (modo híbrido). Ex.: asm
SFAL_REAL=
